# See README.md for the full list of environment variables this app
# reads (GOOGLE_API_KEY, OPENROUTER_API_KEY, NEWSDATA_API_KEY, etc.) --
# only the one added for course-matching is documented here.

# Base URL of the coursefind-data API (POST /v1/qualify), read server-side
# only by app/api/qualify/route.ts. Never exposed to the browser -- the
# client calls this app's own /api/qualify, which proxies to this URL.
# Defaults to a local coursefind-data instance (`uv run uvicorn app.main:app`
# from that repo) if unset.
QUALIFY_API_URL=http://localhost:8000
